# Supabase Connection Settings
# Project URL (Supabase dashboard > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Anon/Public Key (starts with sb_publishable_ or eyJ...)
SUPABASE_KEY=your-anon-key

# Service Role Key (Server-only admin key, starts with sb_secret_ or eyJ...)
SUPABASE_SECRET_KEY=your-service-role-key

# Platform SEO Settings
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_NAME=Burhan

# Cloudflare Turnstile Spam Protection (Optional, required for Digital Observatory submissions)
# Turnstile Site Key (Public)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Turnstile Secret Key (Server-only)
NUXT_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# AI Generation Backend (server-only)
# Nosana is an OpenAI-compatible inference cluster.
# OpenAI-compatible chat endpoint (base URL, e.g. https://api.example.com)
NUXT_NOSANA_API_ENDPOINT=your-nosana-api-endpoint

# Nosana cluster access token (server-only, never expose to the client)
NUXT_NOSANA_CLUSTER_KEY=your-nosana-cluster-key

# Default chat model for AI generation
NUXT_NOSANA_DEFAULT_MODEL=your-nosana-model

# AI kill switch (public flag; when false the generate endpoint rejects all
# new jobs BEFORE any quota reservation, while reading/polling stays working)
NUXT_PUBLIC_AI_GENERATE_ENABLED=true

# Tenant-level AI quota defaults (per organization per calendar month)
NUXT_PUBLIC_AI_REQUEST_LIMIT=100
NUXT_PUBLIC_AI_TOKEN_LIMIT=1000000
